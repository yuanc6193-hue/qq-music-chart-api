
package main

import (
	"encoding/json"
	"log"
	"net/http"
	"os"
	"time"

	"github.com/guohuiyuan/music-lib/qq"
)

func main() {
	mux := http.NewServeMux()

	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
		if r.URL.Path != "/" {
			http.NotFound(w, r)
			return
		}
		w.Header().Set("Content-Type", "application/json; charset=utf-8")
		json.NewEncoder(w).Encode(map[string]any{
			"success": true,
			"message": "QQ Music Chart API is running",
			"endpoint": "/qq/top50",
		})
	})

	mux.HandleFunc("/qq/top50", func(w http.ResponseWriter, r *http.Request) {
		if r.Method != http.MethodGet {
			http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
			return
		}

		songs, err := qq.GetHotSongs(50)
		w.Header().Set("Content-Type", "application/json; charset=utf-8")

		if err != nil {
			w.WriteHeader(http.StatusBadGateway)
			json.NewEncoder(w).Encode(map[string]any{
				"success": false,
				"error":   err.Error(),
			})
			return
		}

		json.NewEncoder(w).Encode(map[string]any{
			"success": true,
			"platform": "qq",
			"chart":   "热歌榜",
			"count":   len(songs),
			"songs":   songs,
		})
	})

	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}

	server := &http.Server{
		Addr:              ":" + port,
		Handler:           mux,
		ReadHeaderTimeout: 10 * time.Second,
	}

	log.Printf("QQ Music Chart API listening on port %s", port)
	log.Fatal(server.ListenAndServe())
}
